# EdgeSight 백엔드 환경변수 예시
# 실제 사용 시 .env 로 복사 후 수정

# 쓰기 엔드포인트 보호용 Bearer 토큰 (미설정 시 인증 비활성)
EDGESIGHT_TOKEN=

# 서버 포트(미설정 시 DB의 server_port 값 사용)
# EDGESIGHT_PORT=8000

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
EDGESIGHT_LOG_LEVEL=INFO

# 모델/설정 디렉토리 (기본: ./models, ./configs)
# EDGESIGHT_MODEL_DIR=./models
# EDGESIGHT_CONFIG_DIR=./configs

# Vite dev server 사용 시 CORS 허용 origin
EDGESIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DB URL (기본: sqlite:///./edge_system.db)
# EDGESIGHT_DB_URL=sqlite:///./edge_system.db

# --- .pt 자동 변환 옵션 ---
# trtexec 실행파일 경로 (기본: /usr/src/tensorrt/bin/trtexec)
# EDGESIGHT_TRTEXEC=/usr/src/tensorrt/bin/trtexec

# 자체 ONNX export 대신 외부 스크립트 사용 (예: DeepStream-Yolo 공식 스크립트)
# EDGESIGHT_PT_EXPORT_SCRIPT=/opt/DeepStream-Yolo/utils/export_yoloV8.py
